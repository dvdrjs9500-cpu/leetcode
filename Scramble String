#include <stdbool.h>
#include <string.h>

// memo[len][i][j]: -1 = unvisited, 0 = false, 1 = true
// len: 1 to 30, i: 0 to 29, j: 0 to 29
static int memo[31][30][30];

static bool solve(const char* s1, const char* s2, int i, int j, int len) {
    if (memo[len][i][j] != -1) {
        return memo[len][i][j] == 1;
    }

    if (strncmp(s1 + i, s2 + j, len) == 0) {
        memo[len][i][j] = 1;
        return true;
    }

    // Pruning: check character frequencies
    int count[26] = {0};
    for (int k = 0; k < len; k++) {
        count[s1[i + k] - 'a']++;
        count[s2[j + k] - 'a']--;
    }
    for (int k = 0; k < 26; k++) {
        if (count[k] != 0) {
            memo[len][i][j] = 0;
            return false;
        }
    }

    for (int k = 1; k < len; k++) {
        // Case 1: No swap
        if (solve(s1, s2, i, j, k) && solve(s1, s2, i + k, j + k, len - k)) {
            memo[len][i][j] = 1;
            return true;
        }
        // Case 2: Swapped
        if (solve(s1, s2, i, j + len - k, k) && solve(s1, s2, i + k, j, len - k)) {
            memo[len][i][j] = 1;
            return true;
        }
    }

    memo[len][i][j] = 0;
    return false;
}

bool isScramble(char* s1, char* s2) {
    int n = strlen(s1);
    memset(memo, -1, sizeof(memo));
    return solve(s1, s2, 0, 0, n);
}
