#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* longestCommonPrefix(char** strs, int strsSize) {
    if (strsSize == 0) {
        char* empty = (char*)malloc(1);
        empty[0] = '\0';
        return empty;
    }

    // Allocate memory for the result string (max length is length of the first string)
    int firstLen = strlen(strs[0]);
    char* prefix = (char*)malloc((firstLen + 1) * sizeof(char));

    for (int i = 0; i < firstLen; i++) {
        char currentChar = strs[0][i];
        
        // Check if currentChar matches the character at index i for all other strings
        for (int j = 1; j < strsSize; j++) {
            if (strs[j][i] == '\0' || strs[j][i] != currentChar) {
                prefix[i] = '\0'; // End string at current index
                return prefix;
            }
        }
        
        prefix[i] = currentChar;
    }

    prefix[firstLen] = '\0';
    return prefix;
}
