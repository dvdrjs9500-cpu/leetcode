#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* countAndSay(int n) {
    // Base case for n = 1
    char* current = (char*)malloc(2 * sizeof(char));
    strcpy(current, "1");

    if (n == 1) {
        return current;
    }

    for (int i = 2; i <= n; i++) {
        int len = strlen(current);
        
        // Upper bound memory allocation for the next string sequence
        char* next = (char*)malloc((len * 2 + 1) * sizeof(char));
        int nextIdx = 0;

        int count = 1;
        for (int j = 0; j < len; j++) {
            // Check if the next character is the same
            if (j + 1 < len && current[j] == current[j + 1]) {
                count++;
            } else {
                // Write count and character to next string
                next[nextIdx++] = count + '0';
                next[nextIdx++] = current[j];
                count = 1; // Reset count
            }
        }
        next[nextIdx] = '\0'; // Null-terminate string

        free(current); // Free memory of previous iteration
        current = next;
    }

    return current;
}
