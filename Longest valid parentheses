#include <string.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))

int longestValidParentheses(char* s) {
    if (!s) return 0;
    
    int s_len = strlen(s);
    int left = 0, right = 0;
    int max_len = 0;

    // Pass 1: Left to Right
    for (int i = 0; i < s_len; i++) {
        if (s[i] == '(') {
            left++;
        } else {
            right++;
        }

        if (left == right) {
            max_len = MAX(max_len, 2 * right);
        } else if (right > left) {
            left = right = 0;
        }
    }

    // Pass 2: Right to Left
    left = right = 0;
    for (int i = s_len - 1; i >= 0; i--) {
        if (s[i] == '(') {
            left++;
        } else {
            right++;
        }

        if (left == right) {
            max_len = MAX(max_len, 2 * left);
        } else if (left > right) {
            left = right = 0;
        }
    }

    return max_len;
}
