#include <stdio.h>
#include <stdlib.h>
#include <string.h>

// Helper function to expand around a given center
int expandAroundCenter(char* s, int left, int right, int length) {
    while (left >= 0 && right < length && s[left] == s[right]) {
        left--;
        right++;
    }
    // Return length of the valid palindrome found
    return right - left - 1;
}

char* longestPalindrome(char* s) {
    if (s == NULL || strlen(s) == 0) {
        char* empty = (char*)malloc(1);
        empty[0] = '\0';
        return empty;
    }

    int len = strlen(s);
    int start = 0;
    int maxLen = 0;

    for (int i = 0; i < len; i++) {
        // Case 1: Odd length palindrome (center is s[i])
        int len1 = expandAroundCenter(s, i, i, len);
        
        // Case 2: Even length palindrome (center is between s[i] and s[i+1])
        int len2 = expandAroundCenter(s, i, i + 1, len);

        // Find the longer of the two
        int currentMax = (len1 > len2) ? len1 : len2;

        if (currentMax > maxLen) {
            maxLen = currentMax;
            // Calculate starting index of this palindrome
            start = i - (currentMax - 1) / 2;
        }
    }

    // Allocate memory for the result substring (+1 for null terminator)
    char* result = (char*)malloc((maxLen + 1) * sizeof(char));
    strncpy(result, s + start, maxLen);
    result[maxLen] = '\0';

    return result;
}
