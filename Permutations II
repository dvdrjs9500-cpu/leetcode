#include <stdlib.h>
#include <stdbool.h>

static int compare(const void *a, const void *b) {
    return (*(int *)a - *(int *)b);
}

static void backtrack(int *nums, int numsSize, int depth, int *path, bool *used, int **result, int *returnSize, int *returnColumnSizes) {
    if (depth == numsSize) {
        result[*returnSize] = (int *)malloc(numsSize * sizeof(int));
        for (int i = 0; i < numsSize; i++) {
            result[*returnSize][i] = path[i];
        }
        returnColumnSizes[*returnSize] = numsSize;
        (*returnSize)++;
        return;
    }

    for (int i = 0; i < numsSize; i++) {
        if (used[i]) continue;
        if (i > 0 && nums[i] == nums[i - 1] && !used[i - 1]) continue;

        used[i] = true;
        path[depth] = nums[i];
        backtrack(nums, numsSize, depth + 1, path, used, result, returnSize, returnColumnSizes);
        used[i] = false;
    }
}

int** permuteUnique(int* nums, int numsSize, int* returnSize, int** returnColumnSizes) {
    qsort(nums, numsSize, sizeof(int), compare);

    int maxPerms = 1;
    for (int i = 1; i <= numsSize; i++) {
        maxPerms *= i;
    }

    int **result = (int **)malloc(maxPerms * sizeof(int *));
    *returnColumnSizes = (int *)malloc(maxPerms * sizeof(int));
    *returnSize = 0;

    int *path = (int *)malloc(numsSize * sizeof(int));
    bool *used = (bool *)calloc(numsSize, sizeof(bool));

    backtrack(nums, numsSize, 0, path, used, result, returnSize, *returnColumnSizes);

    free(path);
    free(used);

    return result;
}
