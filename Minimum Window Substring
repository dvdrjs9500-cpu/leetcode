#include <stdlib.h>
#include <string.h>

char* minWindow(char* s, char* t) {
    int sLen = strlen(s);
    int tLen = strlen(t);
    
    if (sLen == 0 || tLen == 0 || sLen < tLen) {
        char* empty = (char*)malloc(sizeof(char));
        empty[0] = '\0';
        return empty;
    }

    int targetFreq[128] = {0};
    int windowFreq[128] = {0};
    int uniqueTargetChars = 0;

    for (int i = 0; i < tLen; i++) {
        if (targetFreq[(unsigned char)t[i]] == 0) {
            uniqueTargetChars++;
        }
        targetFreq[(unsigned char)t[i]]++;
    }

    int left = 0;
    int formed = 0;
    int minLen = -1;
    int minStart = 0;

    for (int right = 0; right < sLen; right++) {
        unsigned char c = (unsigned char)s[right];
        windowFreq[c]++;

        if (targetFreq[c] > 0 && windowFreq[c] == targetFreq[c]) {
            formed++;
        }

        while (left <= right && formed == uniqueTargetChars) {
            int currentLen = right - left + 1;
            if (minLen == -1 || currentLen < minLen) {
                minLen = currentLen;
                minStart = left;
            }

            unsigned char leftChar = (unsigned char)s[left];
            windowFreq[leftChar]--;
            if (targetFreq[leftChar] > 0 && windowFreq[leftChar] < targetFreq[leftChar]) {
                formed--;
            }
            left++;
        }
    }

    if (minLen == -1) {
        char* empty = (char*)malloc(sizeof(char));
        empty[0] = '\0';
        return empty;
    }

    char* result = (char*)malloc((minLen + 1) * sizeof(char));
    strncpy(result, s + minStart, minLen);
    result[minLen] = '\0';

    return result;
}
