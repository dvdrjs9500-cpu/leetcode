#include <limits.h>

int myAtoi(char* s) {
    if (!s) return 0;

    int i = 0;
    int sign = 1;
    int result = 0;

    // Step 1: Skip leading whitespace
    while (s[i] == ' ') {
        i++;
    }

    // Step 2: Check sign
    if (s[i] == '-' || s[i] == '+') {
        if (s[i] == '-') {
            sign = -1;
        }
        i++;
    }

    // Step 3 & 4: Convert digits and check for 32-bit overflow
    while (s[i] >= '0' && s[i] <= '9') {
        int digit = s[i] - '0';

        // Check overflow/underflow before multiplying by 10
        if (result > INT_MAX / 10 || (result == INT_MAX / 10 && digit > 7)) {
            return (sign == 1) ? INT_MAX : INT_MIN;
        }

        result = result * 10 + digit;
        i++;
    }

    return result * sign;
}
