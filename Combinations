#include <stdlib.h>

void backtrack(int start, int n, int k, int* current, int count, int** result, int* returnSize) {
    if (count == k) {
        result[*returnSize] = (int*)malloc(k * sizeof(int));
        for (int i = 0; i < k; i++) {
            result[*returnSize][i] = current[i];
        }
        (*returnSize)++;
        return;
    }

    // Pruning: ensure there are enough numbers left to fill the combination
    for (int i = start; i <= n - (k - count) + 1; i++) {
        current[count] = i;
        backtrack(i + 1, n, k, current, count + 1, result, returnSize);
    }
}

/**
 * Return an array of arrays of size *returnSize.
 * The sizes of the arrays are returned as *returnColumnSizes array.
 * Note: Both returned array and *columnSizes array must be malloced, assume caller calls free().
 */
int** combine(int n, int k, int* returnSize, int** returnColumnSizes) {
    // Calculate C(n, k) to allocate exact capacity
    long long total = 1;
    for (int i = 1; i <= k; i++) {
        total = total * (n - i + 1) / i;
    }

    int** result = (int**)malloc(total * sizeof(int*));
    *returnColumnSizes = (int*)malloc(total * sizeof(int));
    for (int i = 0; i < total; i++) {
        (*returnColumnSizes)[i] = k;
    }

    int* current = (int*)malloc(k * sizeof(int));
    *returnSize = 0;

    backtrack(1, n, k, current, 0, result, returnSize);

    free(current);
    return result;
}
