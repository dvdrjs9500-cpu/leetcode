#include <stdio.h>
#include <stdlib.h>

// Comparison function for qsort to sort intervals by start time
int compareIntervals(const void* a, const void* b) {
    int* intervalA = *(int**)a;
    int* intervalB = *(int**)b;
    return intervalA[0] - intervalB[0];
}

int** merge(int** intervals, int intervalsSize, int* intervalsColSize, int* returnSize, int** returnColumnSizes) {
    if (intervalsSize <= 0) {
        *returnSize = 0;
        *returnColumnSizes = NULL;
        return NULL;
    }

    // 1. Sort intervals based on starting points
    qsort(intervals, intervalsSize, sizeof(int*), compareIntervals);

    // 2. Allocate dynamic memory for the result matrix
    int** result = (int**)malloc(intervalsSize * sizeof(int*));
    *returnColumnSizes = (int*)malloc(intervalsSize * sizeof(int));

    int count = 0;

    // Allocate and initialize the first interval in the result array
    result[count] = (int*)malloc(2 * sizeof(int));
    result[count][0] = intervals[0][0];
    result[count][1] = intervals[0][1];
    (*returnColumnSizes)[count] = 2;

    // 3. Process remaining intervals
    for (int i = 1; i < intervalsSize; i++) {
        int currentEnd = result[count][1];
        int nextStart = intervals[i][0];
        int nextEnd = intervals[i][1];

        // Overlap detected: merge intervals
        if (nextStart <= currentEnd) {
            if (nextEnd > currentEnd) {
                result[count][1] = nextEnd;
            }
        } else {
            // No overlap: add new interval entry
            count++;
            result[count] = (int*)malloc(2 * sizeof(int));
            result[count][0] = nextStart;
            result[count][1] = nextEnd;
            (*returnColumnSizes)[count] = 2;
        }
    }

    *returnSize = count + 1;
    return result;
}
