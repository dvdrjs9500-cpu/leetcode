#include <stdio.h>
#include <stdbool.h>

bool canJump(int* nums, int numsSize) {
    int max_reachable = 0;

    for (int i = 0; i < numsSize; i++) {
        // If current index is beyond the furthest reachable index, we can't proceed
        if (i > max_reachable) {
            return false;
        }

        // Update the maximum index reachable from current position
        if (i + nums[i] > max_reachable) {
            max_reachable = i + nums[i];
        }

        // Early exit if we can already reach or pass the last index
        if (max_reachable >= numsSize - 1) {
            return true;
        }
    }

    return max_reachable >= numsSize - 1;
}
