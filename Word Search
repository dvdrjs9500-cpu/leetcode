#include <stdbool.h>
#include <string.h>

static bool dfs(char** board, int m, int n, int r, int c, const char* word, int index) {
    if (word[index] == '\0') {
        return true;
    }

    if (r < 0 || r >= m || c < 0 || c >= n || board[r][c] != word[index]) {
        return false;
    }

    char temp = board[r][c];
    board[r][c] = '#'; // Mark cell as visited

    bool found = dfs(board, m, n, r + 1, c, word, index + 1) ||
                 dfs(board, m, n, r - 1, c, word, index + 1) ||
                 dfs(board, m, n, r, c + 1, word, index + 1) ||
                 dfs(board, m, n, r, c - 1, word, index + 1);

    board[r][c] = temp; // Backtrack / unmark
    return found;
}

bool exist(char** board, int boardSize, int* boardColSize, char* word) {
    int m = boardSize;
    int n = boardColSize[0];
    int wordLen = strlen(word);

    if (wordLen > m * n) {
        return false;
    }

    // Optimization: frequency check
    int boardFreq[128] = {0};
    int wordFreq[128] = {0};

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            boardFreq[(unsigned char)board[i][j]]++;
        }
    }

    for (int i = 0; i < wordLen; i++) {
        wordFreq[(unsigned char)word[i]]++;
        if (wordFreq[(unsigned char)word[i]] > boardFreq[(unsigned char)word[i]]) {
            return false;
        }
    }

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < n; j++) {
            if (board[i][j] == word[0]) {
                if (dfs(board, m, n, i, j, word, 0)) {
                    return true;
                }
            }
        }
    }

    return false;
}
