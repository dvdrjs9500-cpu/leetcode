#include <stdbool.h>

bool isValidSudoku(char** board, int boardSize, int* boardColSize) {
    // Frequency arrays to track digits 1-9 (indexed 0-8)
    // rows[i][num] tracks digits in row i
    // cols[j][num] tracks digits in column j
    // boxes[k][num] tracks digits in 3x3 sub-box k
    int rows[9][9] = {0};
    int cols[9][9] = {0};
    int boxes[9][9] = {0};

    for (int i = 0; i < 9; i++) {
        for (int j = 0; j < 9; j++) {
            char current = board[i][j];

            // Skip empty cells
            if (current == '.') {
                continue;
            }

            // Convert char digit '1'-'9' to index 0-8
            int num = current - '1';

            // Calculate sub-box index (0 to 8)
            int boxIndex = (i / 3) * 3 + (j / 3);

            // Check if digit has already appeared in row, col, or box
            if (rows[i][num] || cols[j][num] || boxes[boxIndex][num]) {
                return false;
            }

            // Mark digit as seen
            rows[i][num] = 1;
            cols[j][num] = 1;
            boxes[boxIndex][num] = 1;
        }
    }

    return true;
}
