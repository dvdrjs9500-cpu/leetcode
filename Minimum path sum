int minPathSum(int** grid, int gridSize, int* gridColSize) {
    int m = gridSize;
    int n = gridColSize[0];
    
    int dp[200];
    dp[0] = grid[0][0];
    
    for (int j = 1; j < n; j++) {
        dp[j] = dp[j - 1] + grid[0][j];
    }
    
    for (int i = 1; i < m; i++) {
        dp[0] += grid[i][0];
        for (int j = 1; j < n; j++) {
            int minVal = dp[j] < dp[j - 1] ? dp[j] : dp[j - 1];
            dp[j] = minVal + grid[i][j];
        }
    }
    
    return dp[n - 1];
}
