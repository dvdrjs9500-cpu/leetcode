#include <stdbool.h>
#include <stddef.h>

bool isMatch(char* s, char* p) {
    char* s_ptr = s;
    char* p_ptr = p;
    char* last_s = NULL;
    char* last_p = NULL;

    while (*s_ptr) {
        if (*p_ptr == '?' || *p_ptr == *s_ptr) {
            s_ptr++;
            p_ptr++;
        } else if (*p_ptr == '*') {
            last_p = p_ptr;
            last_s = s_ptr;
            p_ptr++;
        } else if (last_p != NULL) {
            p_ptr = last_p + 1;
            s_ptr = ++last_s;
        } else {
            return false;
        }
    }

    while (*p_ptr == '*') {
        p_ptr++;
    }

    return *p_ptr == '\0';
}
